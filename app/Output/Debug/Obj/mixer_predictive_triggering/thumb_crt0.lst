  49              	//                           Preprocessor Definitions
  50              	//                           ------------------------
  51              	// APP_ENTRY_POINT
  52              	//
  53              	//   Defines the application entry point function, if undefined this setting
  54              	//   defaults to "main".
  55              	//
  56              	// INITIALIZE_STACK
  57              	//
  58              	//   If defined, the contents of the stack will be initialized to a the
  59              	//   value 0xCC.
  60              	//
  61              	// INITIALIZE_SECONDARY_SECTIONS
  62              	//
  63              	//   If defined, the .data2, .text2, .rodata2 and .bss2 sections will be initialized.
  64              	//
  65              	// INITIALIZE_TCM_SECTIONS
  66              	//
  67              	//   If defined, the .data_tcm, .text_tcm, .rodata_tcm and .bss_tcm sections 
  68              	//   will be initialized.
  69              	//
  70              	// INITIALIZE_USER_SECTIONS
  71              	//
  72              	//   If defined, the function InitializeUserMemorySections will be called prior
  73              	//   to entering main in order to allow the user to initialize any user defined
  74              	//   memory sections.
  75              	//
  76              	// FULL_LIBRARY
  77              	//
  78              	//   If defined then 
  79              	//     - argc, argv are setup by the debug_getargs.
  80              	//     - the exit symbol is defined and executes on return from main.
  81              	//     - the exit symbol calls destructors, atexit functions and then debug_exit.
  82              	//  
  83              	//   If not defined then
  84              	//     - argc and argv are zero.
  85              	//     - the exit symbol is defined, executes on return from main and loops
  86              	//
  87              	// STACK_CHECK
  88              	//
  89              	//   If defined will set the v8m msplim/psplim registers to the start of the stacks
  90              	//
  91              	// RETURN_FROM_CRT0
  92              	//
  93              	//   If defined, carry out a return to link register on application exit.
  94              	//
